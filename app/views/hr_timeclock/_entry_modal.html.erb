<%
  # Dynamic kind list based on the user's employment type. Everyone gets the
  # three standard entries; Werkstudent/Praktikant adds Workday + Blocktag,
  # Azubi adds Berufsschule, care-eligible staff add Betreuung.
  entry_kinds = [
    [HrAbsence::KIND_VACATION,   l(:label_hr_vacation)],
    [HrAbsence::KIND_SICKNESS,   l(:label_hr_sickness)],
    [HrAbsence::KIND_OFFSITE,    l(:label_hr_offsite)],
    [HrAbsence::KIND_HOMEOFFICE, l(:label_hr_homeoffice)]
  ]
  if @user_setting.allows_monthly_plan?
    entry_kinds << [HrAbsence::KIND_WORKDAY, l(:label_hr_workday)]
    entry_kinds << [HrAbsence::KIND_BLOCK,   l(:label_hr_block)]
  end
  if @user_setting.effective_school_weekdays.any?
    entry_kinds << [HrAbsence::KIND_SCHOOL, l(:label_hr_school)]
  end
  if @user_setting.care_visible?
    entry_kinds << [HrAbsence::KIND_CARE, l(:label_hr_care)]
  end
  entry_kinds.uniq!
  # Kinds that accept a start/end time window (anything that can be partial-day).
  time_capable_kinds = HrAbsence::RECURRENCE_CAPABLE_KINDS + [HrAbsence::KIND_SICKNESS, HrAbsence::KIND_CARE]
%>
<div id="hr-entry-modal" class="hr-tc-popup" role="dialog" aria-modal="true" aria-hidden="true"
     data-time-capable-kinds="<%= time_capable_kinds.uniq.join(',') %>">
  <div class="hr-tc-popup-inner hr-tc-entry-modal-inner">
    <h3 class="hr-tc-entry-modal-title"><%= l(:label_hr_entry_modal_title) %></h3>
    <%= form_with url: hr_absences_path, method: :post, scope: :hr_absence, local: true,
                  html: { id: 'hr-entry-modal-form' } do |f| %>
      <%= hidden_field_tag :return_to, request.fullpath %>

      <div class="hr-tc-entry-row">
        <%= f.label :kind, l(:label_hr_absence_kind) %>
        <%= f.select :kind, entry_kinds.map { |v, lab| [lab, v] }, {}, { id: 'hr_entry_kind' } %>
      </div>

      <div class="hr-tc-entry-row hr-tc-entry-dates">
        <div>
          <%= f.label :starts_on, l(:label_hr_absence_starts_on) %>
          <%= f.date_field :starts_on, required: true, id: 'hr_entry_starts_on' %>
        </div>
        <div>
          <%= f.label :ends_on, l(:label_hr_absence_ends_on) %>
          <%= f.date_field :ends_on, required: true, id: 'hr_entry_ends_on' %>
        </div>
      </div>

      <div class="hr-tc-entry-row">
        <%= f.label :reason, l(:label_hr_absence_reason) %>
        <%= f.text_field :reason, id: 'hr_entry_reason', maxlength: 200 %>
      </div>

      <%# ─── Zeitfenster (ganztägig / mit Uhrzeit, einheitlich für alle Tage) ─── %>
      <div class="hr-tc-entry-section" data-bind="entry-time-section">
        <div class="hr-tc-entry-row hr-tc-entry-time-row">
          <label><%= l(:label_hr_entry_time_mode) %></label>
          <label class="hr-tc-entry-mode-opt">
            <input type="radio" name="hr_absence[time_mode]" value="full" checked>
            <%= l(:label_hr_entry_time_full) %>
          </label>
          <label class="hr-tc-entry-mode-opt">
            <input type="radio" name="hr_absence[time_mode]" value="partial">
            <%= l(:label_hr_entry_time_partial) %>
          </label>
        </div>
        <div class="hr-tc-entry-row hr-tc-entry-time-fields" data-bind="entry-time-partial" hidden>
          <div>
            <label for="hr_entry_start_time"><%= l(:label_hr_entry_from_time) %></label>
            <%= f.time_field :start_time, step: 60, id: 'hr_entry_start_time', lang: 'de-DE' %>
          </div>
          <div>
            <label for="hr_entry_end_time"><%= l(:label_hr_entry_to_time) %></label>
            <%= f.time_field :end_time, step: 60, id: 'hr_entry_end_time', lang: 'de-DE' %>
          </div>
        </div>
        <div class="hr-tc-entry-row hr-tc-entry-quick-row" data-bind="entry-time-quick" hidden>
          <span class="hr-tc-entry-quick-label"><%= l(:label_hr_entry_quick_duration) %>:</span>
          <button type="button" class="hr-tc-entry-quick-btn" data-hours="4">4 h</button>
          <button type="button" class="hr-tc-entry-quick-btn" data-hours="6">6 h</button>
          <button type="button" class="hr-tc-entry-quick-btn" data-hours="8">8 h</button>
          <em class="info"><%= l(:label_hr_entry_quick_hint) %></em>
        </div>
      </div>

      <%# ─── Multi-Tag: gleich für alle vs. pro Tag (Timeline-Wizard) ─── %>
      <div class="hr-tc-entry-section" data-bind="entry-perday-section" hidden>
        <div class="hr-tc-entry-row">
          <label><%= l(:label_hr_entry_perday_mode) %></label>
          <label class="hr-tc-entry-mode-opt">
            <input type="radio" name="hr_absence[per_day_mode]" value="0" checked>
            <%= l(:label_hr_entry_perday_same) %>
          </label>
          <label class="hr-tc-entry-mode-opt">
            <input type="radio" name="hr_absence[per_day_mode]" value="1">
            <%= l(:label_hr_entry_perday_each) %>
          </label>
        </div>
        <%# Timeline-Wizard: ein einzelner Track, Schritt für Schritt pro Tag.
            Statt N horizontaler Bars (würde nicht skalieren) zeigt der
            Wizard oben das Datum, lässt eine Zeitspanne per Drag ziehen,
            und blendet mit "Weiter" den nächsten Tag ein — vorherige
            Auswahlen bleiben in einer dezenten Farbe als Referenz sichtbar. %>
        <div class="hr-tc-entry-timeline-wizard" data-bind="entry-timeline-wizard" hidden>
          <div class="hr-tc-entry-timeline-head">
            <strong><%= l(:label_hr_entry_timeline_for) %></strong>
            <span class="hr-tc-entry-timeline-current" data-bind="entry-timeline-current-date">—</span>
            <span class="hr-tc-entry-timeline-step">
              (<span data-bind="entry-timeline-step-index">1</span>/<span data-bind="entry-timeline-step-total">—</span>)
            </span>
          </div>
          <div class="hr-tc-entry-timeline-track" data-bind="entry-timeline-track"
               data-start-hour="6" data-end-hour="22">
            <div class="hr-tc-entry-timeline-grid"></div>
            <div class="hr-tc-entry-timeline-prior" data-bind="entry-timeline-prior"></div>
            <div class="hr-tc-entry-timeline-selection" data-bind="entry-timeline-selection" hidden></div>
          </div>
          <div class="hr-tc-entry-timeline-axis" data-bind="entry-timeline-axis"></div>
          <div class="hr-tc-entry-timeline-controls">
            <span class="hr-tc-entry-timeline-time">
              <span data-bind="entry-timeline-from">--:--</span> – <span data-bind="entry-timeline-to">--:--</span>
            </span>
            <button type="button" data-bind="entry-timeline-skip" class="hr-tc-entry-timeline-skip-btn">
              <%= l(:button_hr_entry_timeline_skip) %>
            </button>
            <button type="button" data-bind="entry-timeline-prev" class="hr-tc-entry-timeline-nav-btn">
              ← <%= l(:button_hr_entry_timeline_prev) %>
            </button>
            <button type="button" data-bind="entry-timeline-next" class="hr-tc-entry-timeline-nav-btn hr-tc-entry-timeline-next-btn">
              <%= l(:button_hr_entry_timeline_next) %> →
            </button>
          </div>
          <p class="hr-tc-entry-timeline-hint"><%= l(:label_hr_entry_timeline_hint) %></p>
        </div>
      </div>

      <%# ─── Recurrence (nur bei recurrence-fähigen Kinds) ─── %>
      <div class="hr-tc-entry-section" data-bind="entry-recurrence-section" hidden>
        <div class="hr-tc-entry-row">
          <%= f.label :recurrence, l(:label_hr_recurrence) %>
          <%= f.select :recurrence,
                       [[l(:label_hr_recurrence_none),        HrAbsence::RECURRENCE_NONE],
                        [l(:label_hr_recurrence_weekly),      HrAbsence::RECURRENCE_WEEKLY],
                        [l(:label_hr_recurrence_biweekly),    HrAbsence::RECURRENCE_BIWEEKLY],
                        [l(:label_hr_recurrence_four_weekly), HrAbsence::RECURRENCE_4_WEEKLY],
                        [l(:label_hr_recurrence_monthly),     HrAbsence::RECURRENCE_MONTHLY]],
                       {}, { id: 'hr_entry_recurrence' } %>
        </div>
        <div class="hr-tc-entry-row" data-bind="entry-recurrence-until" hidden>
          <%= f.label :recurrence_until, l(:label_hr_recurrence_until) %>
          <%= f.date_field :recurrence_until, id: 'hr_entry_recurrence_until' %>
        </div>
      </div>

      <div class="hr-tc-entry-actions">
        <%= submit_tag l(:button_hr_entry_save), class: 'button-positive' %>
        <button type="button" class="hr-tc-entry-cancel"><%= l(:button_cancel) %></button>
      </div>
    <% end %>
  </div>
</div>
