<% if absences.empty? %>
  <p class="nodata"><%= l(:label_hr_absence_none) %></p>
<% else %>
  <%
    # Verfügbare Kinds in der Liste → gefilterte Tabs oberhalb der Tabelle.
    kinds_present = absences.map(&:kind).uniq
    kind_order    = HrAbsence::KINDS & kinds_present
    show_user_col = local_assigns[:show_user]
    groups        = hr_group_consecutive_absences(absences)
  %>

  <div class="hr-tc-abs-tabs" role="tablist">
    <button type="button" class="hr-tc-abs-tab active" data-filter="all">
      <%= l(:label_hr_absence_tab_all) %>
      <span class="hr-tc-abs-tab-count"><%= groups.size %></span>
    </button>
    <% kind_order.each do |k| %>
      <%
        kind_groups = groups.count { |g| g[:absences].first.kind == k }
        next if kind_groups.zero?
      %>
      <button type="button" class="hr-tc-abs-tab hr-tc-abs-tab-<%= k %>" data-filter="<%= k %>">
        <%= HrAbsence.kind_label(k) %>
        <span class="hr-tc-abs-tab-count"><%= kind_groups %></span>
      </button>
    <% end %>
  </div>

  <table class="list hr-tc-abs-table">
    <thead>
      <tr>
        <th><%= l(:label_hr_absence_period) %></th>
        <th><%= l(:label_hr_absence_days) %></th>
        <th><%= l(:label_hr_absence_status) %></th>
        <th><%= l(:label_hr_absence_reason) %></th>
        <th><%= l(:label_hr_absence_history) %></th>
        <% if show_user_col %>
          <th><%= l(:label_hr_admin_user) %></th>
        <% end %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% groups.each do |group| %>
        <%
          first_abs  = group[:absences].first
          group_size = group[:absences].size
          period_str = if group[:starts_on] == group[:ends_on]
                         I18n.l(group[:starts_on])
                       else
                         "#{I18n.l(group[:starts_on])} — #{I18n.l(group[:ends_on])}"
                       end
          # Aggregate day/working_day counts across the group.
          days_total = group[:absences].sum do |a|
            a.vacation? ? a.working_days_value.to_f : a.days.to_f
          end
        %>
        <tr class="hr-tc-abs-row hr-tc-abs-<%= first_abs.status %> hr-tc-abs-kind-<%= first_abs.kind %>"
            data-kind="<%= first_abs.kind %>">
          <td>
            <%= period_str %>
            <% if first_abs.partial? %>
              <span class="hr-tc-partial-time">· <%= h first_abs.start_time %> – <%= h first_abs.end_time %></span>
            <% end %>
            <% if group_size > 1 %>
              <span class="hr-tc-abs-group-count" title="<%= l(:label_hr_absence_group_hint, count: group_size) %>">
                · <%= l(:label_hr_absence_group_entries, count: group_size) %>
              </span>
            <% end %>
          </td>
          <td>
            <% if first_abs.vacation? %>
              <%= l(:label_hr_absence_working_days_value, days: hr_format_days(days_total)) %>
              <% if first_abs.first_day_half? || first_abs.last_day_half? %>
                <span class="hr-tc-half-marker" title="<%= l(:label_hr_absence_first_day_half) %>"><%= l(:label_hr_absence_half_day_marker) %></span>
              <% end %>
              <% rem = HrAbsence.vacation_remaining(first_abs.user, first_abs.starts_on.year) %>
              <span class="hr-tc-vacation-remaining" title="<%= l(:label_hr_vacation_remaining_full, used: hr_format_days(rem[:used]), allowed: rem[:allowed], year: first_abs.starts_on.year) %>">
                · <%= l(:label_hr_vacation_remaining_short, remaining: hr_format_days(rem[:remaining]), allowed: rem[:allowed]) %>
              </span>
            <% elsif first_abs.sickness? %>
              <%= days_total.to_i %>
              <% sick_mins = group[:absences].sum { |a| a.sickness_consumed_minutes.to_i } %>
              <span class="hr-tc-sickness-hours" title="<%= l(:label_hr_sickness_hours_suffix_full) %>">
                · <%= hr_format_seconds((sick_mins * 60).to_i) %>
              </span>
            <% else %>
              <%= days_total.to_i %>
            <% end %>
          </td>
          <td>
            <span class="hr-tc-abs-pill hr-tc-abs-pill-<%= first_abs.kind %><%= ' hr-tc-abs-pill-pending' if first_abs.requested? %>">
              <%= HrAbsence.kind_label(first_abs.kind) %><% unless first_abs.approved? %> · <%= HrAbsence.status_label(first_abs.status) %><% end %>
            </span>
          </td>
          <td><%= h first_abs.reason %></td>
          <td class="hr-tc-abs-audit-cell">
            <% audits = first_abs.audits.includes(:actor).to_a %>
            <% if audits.empty? && first_abs.approver %>
              <div class="hr-tc-abs-audit-entry">
                <strong><%= HrAbsenceAudit.action_label(first_abs.approved? ? 'approved' : 'rejected') %>:</strong>
                <%= h(first_abs.approver.name) %>
                <small>(<%= format_time(first_abs.approved_at) if first_abs.approved_at %>)</small>
              </div>
            <% end %>
            <% audits.each do |audit| %>
              <div class="hr-tc-abs-audit-entry hr-tc-abs-audit-<%= audit.action %>">
                <strong><%= HrAbsenceAudit.action_label(audit.action) %>:</strong>
                <%= h(audit.actor&.name || '?') %>
                <small>(<%= format_time(audit.created_at) %>)</small>
              </div>
            <% end %>
          </td>
          <% if show_user_col %>
            <td><%= link_to h(first_abs.user.name), hr_admin_user_path(user_id: first_abs.user.id) %></td>
          <% end %>
          <td class="hr-tc-abs-actions">
            <% if User.current.admin? && first_abs.requested? %>
              <%= button_to l(:button_hr_absence_approve), approve_hr_absence_path(id: first_abs.id), method: :post, class: 'button-positive' %>
              <%= button_to l(:button_hr_absence_reject),  reject_hr_absence_path(id: first_abs.id),  method: :post, class: 'button-negative' %>
            <% end %>
            <% if (first_abs.user_id == User.current.id && (first_abs.requested? || first_abs.sickness? || first_abs.offsite?)) || User.current.admin? %>
              <a href="#" class="icon icon-edit hr-tc-edit-absence-btn"
                 data-absence-id="<%= first_abs.id %>"
                 data-update-url="<%= hr_absence_path(id: first_abs.id) %>"
                 data-starts-on="<%= first_abs.starts_on.iso8601 %>"
                 data-ends-on="<%= first_abs.ends_on.iso8601 %>"
                 data-reason="<%= h first_abs.reason %>"
                 data-status="<%= first_abs.status %>"
                 data-kind="<%= first_abs.kind %>"
                 data-kind-label="<%= h HrAbsence.kind_label(first_abs.kind) %>"><%= l(:button_hr_absence_edit) %></a>
              <%= button_to l(:button_hr_absence_delete), hr_absence_path(id: first_abs.id), method: :delete, class: 'icon icon-del',
                            data: { confirm: l(:text_are_you_sure) } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
