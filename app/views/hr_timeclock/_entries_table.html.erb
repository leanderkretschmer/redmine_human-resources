<%
  show_corrections = local_assigns.fetch(:correctable, true) &&
                     entries.any? { |e| e.user_id == User.current.id && !e.open? }
%>
<% if entries.empty? %>
  <p class="nodata"><%= l(:label_hr_timeclock_state_idle) %></p>
<% else %>
  <table class="list hr-tc-entries-table">
    <thead>
      <tr>
        <th><%= l(:label_hr_timeclock_session_started_at) %></th>
        <th><%= l(:label_hr_timeclock_session_ended_at) %></th>
        <th><%= l(:label_hr_timeclock_break_col) %></th>
        <th><%= l(:label_hr_timeclock_worked_col) %></th>
        <th><%= l(:label_hr_timeclock_state) %></th>
        <% if show_corrections %><th></th><% end %>
      </tr>
    </thead>
    <tbody>
      <% entries.each do |e| %>
        <%
          pending = e.pending_correction?
          row_classes = []
          row_classes << 'hr-tc-entry-pending-correction' if pending
          tz = RedmineHumanResources::Settings.user_time_zone(User.current)
          started_local = e.started_at&.in_time_zone(tz)
          ended_local   = e.ended_at&.in_time_zone(tz)
          proposed_start_local = e.proposed_started_at&.in_time_zone(tz)
          proposed_end_local   = e.proposed_ended_at&.in_time_zone(tz)
        %>
        <tr class="<%= row_classes.join(' ') %>">
          <td>
            <%= format_time(e.started_at) %>
            <% if pending %>
              <br>
              <span class="hr-tc-entry-correction-arrow" title="<%= l(:label_hr_correction_proposed) %>">
                → <strong><%= proposed_start_local ? proposed_start_local.strftime('%H:%M') : '—' %></strong>
              </span>
            <% end %>
          </td>
          <td>
            <%= e.ended_at ? format_time(e.ended_at) : '—' %>
            <% if pending %>
              <br>
              <span class="hr-tc-entry-correction-arrow" title="<%= l(:label_hr_correction_proposed) %>">
                → <strong><%= proposed_end_local ? proposed_end_local.strftime('%H:%M') : '—' %></strong>
              </span>
            <% end %>
          </td>
          <td><%= hr_format_seconds(e.total_break_seconds) %></td>
          <td><%= hr_format_seconds(e.net_seconds) %></td>
          <td>
            <%= hr_state_label(e.state) %>
            <% if pending %>
              <span class="hr-tc-entry-correction-badge" title="<%= h e.correction_reason %>">
                <%= l(:label_hr_correction_pending) %>
              </span>
            <% end %>
          </td>
          <% if show_corrections %>
            <td class="hr-tc-entry-actions">
              <% if e.user_id == User.current.id && !e.open? %>
                <button type="button"
                        class="hr-tc-entry-correct-btn"
                        data-entry-id="<%= e.id %>"
                        data-url="<%= propose_correction_hr_entry_path(id: e.id) %>"
                        data-started-at="<%= started_local&.strftime('%Y-%m-%dT%H:%M') %>"
                        data-ended-at="<%= ended_local&.strftime('%Y-%m-%dT%H:%M') %>"
                        data-pending="<%= pending ? '1' : '0' %>"
                        data-reason="<%= h e.correction_reason %>">
                  <%= pending ? l(:button_hr_correction_update) : l(:button_hr_correction_request) %>
                </button>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
